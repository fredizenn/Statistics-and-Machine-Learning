   "source": [
    "# ── Task 8 Setup (do not modify) ──────────────────────────────────────────────\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# scipy.stats is needed for:\n",
    "#   stats.norm.pdf()  -> compute the Normal probability density function\n",
    "#   stats.skew()      -> compute skewness of an array\n",
    "from scipy import stats\n",
    "\n",
    "sns.set_theme(style='whitegrid', palette='muted')\n",
    "\n",
    "# Wide default figure size suits side-by-side distribution comparison plots.\n",
    "plt.rcParams['figure.figsize'] = (14, 4)\n",
    "\n",
    "# Fix the random seed so all students generate the same synthetic datasets.\n",
    "# Every np.random call after this line is reproducible.\n",
    "np.random.seed(42)\n",
    "\n",
    "URL = 'https://raw.githubusercontent.com/plotly/datasets/master/diabetes.csv'\n",
    "df = pd.read_csv(URL)\n",
    "df['DiabetesStatus'] = df['Outcome'].map({0: 'Non-Diabetic', 1: 'Diabetic'})\n",
    "\n",
    "# N is set to match the real dataset size (768 rows) so synthetic and real\n",
    "# distributions are visually comparable — same number of observations.\n",
    "N = 768\n",
    "print(f'Ready (N = {N})')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "task8-normal-provided",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Provided: generate a synthetic Normal distribution and compare it to real Glucose\n",
    "\n",
    "# Use the real Glucose mean and std as parameters so the synthetic distribution\n",
    "# is directly comparable to the real feature in the right panel.\n",
    "mu, sigma = df['Glucose'].mean(), df['Glucose'].std()\n",
    "\n",
    "# np.random.normal() draws N samples from N(mu, sigma).\n",
    "# Because np.random.seed(42) was set in the setup cell, this is reproducible.\n",
    "normal_data = np.random.normal(loc=mu, scale=sigma, size=N)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "# --- Left panel: synthetic Normal ---\n",
    "# density=True rescales the y-axis from raw counts to probability density,\n",
    "# so the histogram bars and the PDF curve share the same y-axis and are comparable.\n",
    "axes[0].hist(normal_data, bins=30, color='steelblue', edgecolor='white', density=True)\n",
    "\n",
    "# The Probability Density Function fit (PDF) curve is a mathematical function of the PARAMETERS (mu, sigma),\n",
    "# not of any particular random sample.\n",
    "# We define x using mu +/- 3.5*sigma to cover >99.9% of the Normal distribution,\n",
    "# regardless of what the random sample happened to produce at its extremes.\n",
    "x = np.linspace(mu - 3.5 * sigma, mu + 3.5 * sigma, 300)\n",
    "\n",
    "# Normal Probability Density Function (Normal PDF)\n",
    "# stats.norm.pdf(x, mu, sigma) evaluates the Normal PDF:\n",
    "#   f(x) = (1 / (sigma * sqrt(2*pi))) * exp(-0.5 * ((x - mu) / sigma)^2)\n",
    "# at each point in x. The result is a smooth bell curve.\n",
    "axes[0].plot(x, stats.norm.pdf(x, mu, sigma), 'r-', lw=2, label='Normal PDF')\n",
    "axes[0].set_title(f'Synthetic Normal\\nmu={mu:.1f}, sigma={sigma:.1f}, skewness={stats.skew(normal_data):.2f}')\n",
    "axes[0].set_xlabel('Value')\n",
    "axes[0].legend()\n",
    "\n",
    "# --- Right panel: real Glucose with its own fitted PDF ---\n",
    "# We compute mu_g and sigma_g separately from the real data.\n",
    "# This fitted PDF shows how well a Normal distribution describes the real feature.\n",
    "# If the bars deviate from the curve, the feature is not perfectly Normal.\n",
    "mu_g, sigma_g = df['Glucose'].mean(), df['Glucose'].std()\n",
    "axes[1].hist(df['Glucose'], bins=30, color='coral', edgecolor='white', density=True)\n",
    "x_g = np.linspace(mu_g - 3.5 * sigma_g, mu_g + 3.5 * sigma_g, 300)\n",
    "axes[1].plot(x_g, stats.norm.pdf(x_g, mu_g, sigma_g), 'r-', lw=2, label='Normal PDF fit')\n",
    "axes[1].set_title(f'Real Glucose Feature\\nmu={mu_g:.1f}, sigma={sigma_g:.1f}, skewness={stats.skew(df[\"Glucose\"]):.2f}')\n",
    "axes[1].set_xlabel('Glucose (mg/dL)')\n",
    "axes[1].legend()\n",
    "\n",
    "plt.suptitle('Normal Distribution: Synthetic vs Real', fontsize=12, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
