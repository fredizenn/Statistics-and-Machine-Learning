    "# Provided: compute and visualise skewness for all numeric features\n",
    "\n",
    "# df[NUMERIC_COLS].skew() computes the sample skewness for each column.\n",
    "# Skewness formula: (1/n) * sum((x - mean)^3) / std^3\n",
    "# Positive value -> right tail is longer (mean > median)\n",
    "# Negative value -> left tail is longer  (mean < median)\n",
    "# Near zero      -> approximately symmetric\n",
    "skewness = df[NUMERIC_COLS].skew().sort_values(ascending=False).round(3)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 4))\n",
    "\n",
    "# Colour bars: tomato (red) for positive skew, steelblue for negative skew.\n",
    "# This makes the direction of asymmetry immediately visible.\n",
    "colors = ['tomato' if s > 0 else 'steelblue' for s in skewness]\n",
    "skewness.plot(kind='bar', ax=ax, color=colors, edgecolor='white')\n",
    "\n",
    "# Reference lines to aid interpretation:\n",
    "# Black dashed line at 0: perfect symmetry\n",
    "# Orange dotted lines at +/-0.5: a common rule-of-thumb threshold —\n",
    "#   |skewness| < 0.5  -> approximately symmetric (safe to use mean)\n",
    "#   |skewness| > 0.5  -> noticeably skewed (prefer median)\n",
    "#   |skewness| > 1.0  -> highly skewed (mean is misleading)\n",
    "ax.axhline(0, color='black', linewidth=0.8, linestyle='--')\n",
    "ax.axhline( 0.5, color='orange', linewidth=0.8, linestyle=':', label='+/-0.5 threshold')\n",
    "ax.axhline(-0.5, color='orange', linewidth=0.8, linestyle=':')\n",
    "ax.set_title('Skewness of All Numeric Features (red = positive, blue = negative)')\n",
    "ax.set_ylabel('Skewness')\n",
    "ax.tick_params(axis='x', rotation=30)\n",
    "ax.legend()\n",
    "\n",
    "# Annotate each bar with its exact value.\n",
    "# Positive bars: label just above the bar top.\n",
    "# Negative bars: label just below the bar top (hence the negative offset).\n",
    "for i, v in enumerate(skewness):\n",
    "    ax.text(i, v + (0.05 if v >= 0 else -0.15), f'{v:.2f}', ha='center', fontsize=8)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print('\\nSkewness values:')\n",
    "print(skewness)\n"
   ]
