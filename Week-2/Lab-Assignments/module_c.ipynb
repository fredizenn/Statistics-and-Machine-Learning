   "source": [
    "# Provided: replace zeros with NaN, then apply MEAN imputation\n",
    "\n",
    "# Step 1: Create a clean copy, never overwrite the raw dataset.\n",
    "#         .copy() ensures df_mean and df_raw are independent objects in memory.\n",
    "#         Without .copy(), modifying df_mean would also modify df_raw.\n",
    "df_mean = df_raw.copy()\n",
    "\n",
    "# Step 2: Replace impossible zeros with NaN.\n",
    "#         .replace(0, np.nan) converts every 0 in the selected columns to NaN.\n",
    "df_mean[SUSPECT_COLS] = df_mean[SUSPECT_COLS].replace(0, np.nan)\n",
    "\n",
    "# Step 3: Fill NaN with the column mean (mean imputation).\n",
    "#         .fillna(df_mean[SUSPECT_COLS].mean()) computes each column's mean\n",
    "#         (ignoring NaN) and fills missing entries with it.\n",
    "col_means = df_mean[SUSPECT_COLS].mean()   # compute means BEFORE filling\n",
    "df_mean[SUSPECT_COLS] = df_mean[SUSPECT_COLS].fillna(col_means)\n",
    "\n",
    "# Verify: NaN count should now be zero in all suspect columns.\n",
    "print('--- After mean imputation ---')\n",
    "print('Remaining NaN values:')\n",
    "print(df_mean[SUSPECT_COLS].isnull().sum())\n",
    "print()\n",
    "\n",
    "# Compare means before and after.\n",
    "print('Mean values (raw vs mean-imputed):')\n",
    "comparison = pd.DataFrame({\n",
    "    'Raw mean':  df_raw[SUSPECT_COLS].replace(0, np.nan).mean(),\n",
    "    'After mean imputation': df_mean[SUSPECT_COLS].mean()\n",
    "}).round(2)\n",
    "print(comparison)\n"
   ]
