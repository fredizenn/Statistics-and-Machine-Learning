   "source": [
    "# Provided: systematic sampling, select every k-th row after a random start\n",
    "\n",
    "# --- Systematic Sampling ---\n",
    "# Step 1: Calculate the sampling interval k = N / n.\n",
    "#         With 768 patients and n=100, we select approximately every 7th row.\n",
    "N = len(df)                      # total number of rows in the dataset\n",
    "k = N // SAMPLE_SIZE             # integer division, floor(768/100) = 7\n",
    "\n",
    "# Step 2: Pick a random starting index between 0 and k-1.\n",
    "#         Starting at a random point prevents always choosing the same first rows.\n",
    "start = np.random.randint(0, k)\n",
    "\n",
    "# Step 3: Select every k-th row beginning from 'start'.\n",
    "#         np.arange produces index positions; .iloc retrieves those rows by position.\n",
    "indices = np.arange(start, N, k)                   # e.g. [3, 10, 17, 24, ...]\n",
    "systematic_sample = df.iloc[indices[:SAMPLE_SIZE]]  # cap at exactly SAMPLE_SIZE rows\n",
    "\n",
    "sys_mean = systematic_sample['Glucose'].mean()\n",
    "print(f'Systematic sample mean  : {sys_mean:.2f} mg/dL')\n",
    "print(f'Difference from pop mean: {abs(sys_mean - pop_mean_glucose):.2f} mg/dL')\n"
   ]
