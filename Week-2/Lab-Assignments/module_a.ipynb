    "# Provided: CLT simulation for n=5 with theoretical Normal overlay\n",
    "\n",
    "# --- CLT simulation ---\n",
    "# We repeat 3000 times:\n",
    "#   draw a sample of size n → compute its mean → record the mean.\n",
    "# The histogram of all 3000 means is the sampling distribution.\n",
    "# The CLT predicts this should look Normal with:\n",
    "#   mean  = population mean (mu)\n",
    "#   std   = population std / sqrt(n)   ← this is called the Standard Error (SE)\n",
    "\n",
    "N_SIMS = 3000\n",
    "n_demo = 5   # small sample: CLT is not yet fully active\n",
    "\n",
    "means_n5 = np.array([\n",
    "    np.random.choice(insulin_pop, size=n_demo, replace=True).mean()\n",
    "    for _ in range(N_SIMS)\n",
    "])\n",
    "\n",
    "# Compute the theoretical Normal the CLT predicts.\n",
    "mu_theory  = insulin_pop.mean()                   # CLT prediction: mean of sample means = population mean\n",
    "se_theory  = insulin_pop.std() / np.sqrt(n_demo)  # CLT prediction: SE = sigma / sqrt(n)\n",
    "\n",
    "# Create a range of x values for plotting the theoretical Normal curve.\n",
    "x_range = np.linspace(means_n5.min(), means_n5.max(), 300)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "ax.hist(means_n5, bins=50, density=True, color='coral',\n",
    "        edgecolor='white', alpha=0.8, label='Simulated sample means')\n",
    "\n",
    "# Overlay the Normal PDF predicted by the CLT.\n",
    "# stats.norm.pdf(x, loc=mu, scale=sigma) computes the Normal probability density at x.\n",
    "ax.plot(x_range, stats.norm.pdf(x_range, mu_theory, se_theory),\n",
    "        color='navy', linewidth=2.5, label='CLT: predicted Normal')\n",
    "\n",
    "ax.set_title(f'Sampling Distribution of Mean Insulin  (n={n_demo}, {N_SIMS} simulations)\\n'\n",
    "             f'still skewed at small n')\n",
    "ax.set_xlabel('Sample Mean Insulin (mu U/ml)')\n",
    "ax.set_ylabel('Density')\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
