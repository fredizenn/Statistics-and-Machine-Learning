   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Population mean Glucose : 120.89 mg/dL  (this is our benchmark)\n",
      "Random sample mean      : 119.95 mg/dL\n",
      "Difference from pop mean: 0.94 mg/dL\n"
     ]
    }
   ],
   "source": [
    "# Provided: simple random sampling and population benchmark\n",
    "\n",
    "# --- Population benchmark ---\n",
    "# Before sampling, record the TRUE population mean so we can measure each sample's bias.\n",
    "# 'Population' here means all 768 rows in the dataset, not literal all diabetic patients.\n",
    "pop_mean_glucose = df['Glucose'].mean()\n",
    "print(f'Population mean Glucose : {pop_mean_glucose:.2f} mg/dL  (this is our benchmark)')\n",
    "\n",
    "# --- Simple Random Sampling ---\n",
    "# .sample(n, random_state) draws n rows uniformly at random WITHOUT replacement.\n",
    "# Every row has an equal probability of being chosen, minimising selection bias.\n",
    "# Fixing random_state ensures the exact same 100 rows are chosen every run.\n",
    "SAMPLE_SIZE = 100\n",
    "random_sample = df.sample(n=SAMPLE_SIZE, random_state=42)\n",
    "\n",
    "rand_mean = random_sample['Glucose'].mean()\n",
    "print(f'Random sample mean      : {rand_mean:.2f} mg/dL')\n",
    "print(f'Difference from pop mean: {abs(rand_mean - pop_mean_glucose):.2f} mg/dL')\n"
   ]
