   "source": [
    "# ── Task 1 Setup (do not modify) ──────────────────────────────────────────────\n",
    "\n",
    "# pandas: tabular data manipulation (DataFrames, read_csv, groupby, etc.)\n",
    "import pandas as pd\n",
    "\n",
    "# numpy: numerical operations: arrays, random numbers, mathematical functions\n",
    "import numpy as np\n",
    "\n",
    "# matplotlib + seaborn: the standard Python plotting pair used throughout this course\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Apply a consistent visual style to every plot produced in this task.\n",
    "# 'whitegrid' adds light horizontal gridlines; 'muted' uses softer, print-friendly colours.\n",
    "sns.set_theme(style='whitegrid', palette='muted')\n",
    "\n",
    "# Default figure dimensions (width × height in inches): individual plots override this.\n",
    "plt.rcParams['figure.figsize'] = (10, 4)\n",
    "\n",
    "# Load the Pima Indians Diabetes dataset from a public GitHub URL.\n",
    "# Using a URL avoids local file dependencies, the notebook runs anywhere.\n",
    "URL = 'https://raw.githubusercontent.com/plotly/datasets/master/diabetes.csv'\n",
    "df = pd.read_csv(URL)\n",
    "\n",
    "# Fix the random seed to get identical samples when running provided cells.\n",
    "np.random.seed(42)\n",
    "\n",
    "print(f'Dataset loaded: {df.shape[0]} rows x {df.shape[1]} columns')\n"
   ]
  },
