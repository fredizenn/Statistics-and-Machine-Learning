    "# Provided: demonstrate sampling bias by restricting the sampling frame\n",
    "\n",
    "# --- Unbiased sample ---\n",
    "# Drawn from the entire dataset, every patient has an equal chance of inclusion.\n",
    "unbiased = df.sample(n=50, random_state=42)\n",
    "unbiased_mean = unbiased['Glucose'].mean()\n",
    "\n",
    "# --- Biased sample ---\n",
    "# Only Diabetic patients are in the sampling frame.\n",
    "# This simulates a real bias: e.g. only patients who visited a diabetes clinic were surveyed.\n",
    "# The resulting mean will be systematically higher than the true population mean.\n",
    "diabetic_only = df[df['Outcome'] == 1]\n",
    "biased = diabetic_only.sample(n=50, random_state=42)\n",
    "biased_mean = biased['Glucose'].mean()\n",
    "\n",
    "pop_mean = df['Glucose'].mean()\n",
    "\n",
    "print(f'True population mean      : {pop_mean:.2f} mg/dL')\n",
