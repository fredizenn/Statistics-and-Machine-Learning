    "# Provided: simulate a sampling distribution for n=10 to visualise spread\n",
    "\n",
    "# --- What is a sampling distribution? ---\n",
    "# If we repeated the sampling process many times, we would get a slightly different\n",
    "# sample mean each time. The distribution of all those means is the 'sampling distribution'.\n",
    "# As n increases, this distribution becomes narrower and more Normal (CLT, see Task 3).\n",
    "\n",
    "N_SIMULATIONS = 2000   # number of times we repeat the sampling process\n",
    "n = 10                 # sample size per draw, deliberately small to show high spread\n",
    "\n",
    "# List comprehension: draw a random sample of size n, compute its mean, repeat 2000 times.\n",
    "sample_means_10 = [\n",
    "    np.random.choice(glucose_pop, size=n, replace=True).mean()\n",
    "    for _ in range(N_SIMULATIONS)\n",
    "]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "\n",
    "# Plot the distribution of sample means as a histogram.\n",
    "# kde=True overlays a smooth density curve so the shape is easier to read.\n",
    "ax.hist(sample_means_10, bins=40, color='steelblue', edgecolor='white',\n",
    "        alpha=0.8, density=True, label='Sample means (n=10)')\n",
    "\n",
    "# Mark the true population mean with a vertical line for comparison.\n",
    "ax.axvline(pop_mean, color='red', linestyle='--', linewidth=2,\n",
    "           label=f'Population mean = {pop_mean:.1f}')\n",
    "\n",
    "ax.set_title('Sampling Distribution of the Mean (n=10, 2000 simulations)')\n",
    "ax.set_xlabel('Sample Mean Glucose (mg/dL)')\n",
    "ax.set_ylabel('Density')\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f'Mean of sample means : {np.mean(sample_means_10):.2f}  (should be close to {pop_mean:.2f})')\n",
    "print(f'Std of sample means  : {np.std(sample_means_10):.2f}  (this is the Standard Error of the Mean)')\n"
   ]
