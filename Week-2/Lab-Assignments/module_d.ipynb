    "# Provided: Simple Linear Regression, predict BMI from Glucose only\n",
    "\n",
    "# --- Why Simple LR first? ---\n",
    "# Starting with one predictor makes the model completely visualisable (scatter + line).\n",
    "# It also establishes a baseline: if Multiple LR barely improves over Simple LR,\n",
    "# the extra features are not contributing much.\n",
    "\n",
    "# sklearn requires X to be 2-D, double brackets [[...]] give shape (n, 1) instead of (n,).\n",
    "X_tr_slr = X_tr[['Glucose']]   # train set, one column\n",
    "X_te_slr = X_te[['Glucose']]   # test set, one column\n",
    "\n",
    "slr = LinearRegression()          # create the model object\n",
    "slr.fit(X_tr_slr, y_tr)          # fit ONLY on the training set\n",
    "\n",
    "# intercept_ = β₀: predicted BMI when Glucose = 0 (algebraically necessary; not clinically meaningful here)\n",
    "# coef_[0]   = β₁: expected change in BMI per 1 mg/dL increase in Glucose\n",
    "print(f'Intercept  β₀ = {slr.intercept_:.4f}')\n",
    "print(f'Slope      β₁ = {slr.coef_[0]:.4f}')\n",
    "print(f'Equation   : BMI = {slr.intercept_:.2f} + {slr.coef_[0]:.4f} × Glucose')\n",
    "print()\n",
    "\n",
    "# Evaluate on the TEST set, this is the honest performance estimate.\n",
    "y_pred_slr = slr.predict(X_te_slr)\n",
    "mae  = mean_absolute_error(y_te, y_pred_slr)\n",
    "rmse = np.sqrt(mean_squared_error(y_te, y_pred_slr))\n",
    "r2   = r2_score(y_te, y_pred_slr)\n",
    "print(f'--- Simple LR Test-Set Performance ---')\n",
    "print(f'MAE  = {mae:.4f}  (average absolute error in BMI units)')\n",
    "print(f'RMSE = {rmse:.4f}  (root mean squared error, penalises large errors more)')\n",
    "print(f'R²   = {r2:.4f}  (fraction of BMI variance explained by Glucose alone)')\n",
    "\n",
    "# --- Visualise: scatter + regression line + residuals ---\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
    "\n",
    "# Left: scatter plot with the fitted line.\n",
    "axes[0].scatter(X_te_slr, y_te, alpha=0.4, s=20, color='steelblue', label='Test data')\n",
    "x_line = np.linspace(X_te_slr.min().values[0], X_te_slr.max().values[0], 200).reshape(-1,1)\n",
    "axes[0].plot(x_line, slr.predict(x_line), color='red', linewidth=2, label='Regression line')\n",
    "axes[0].set_xlabel('Glucose (mg/dL)')\n",
    "axes[0].set_ylabel('BMI')\n",
    "axes[0].set_title(f'Simple LR: Glucose → BMI  (Test R²={r2:.3f})')\n",
    "axes[0].legend()\n",
    "\n",
    "# Right: residual plot, residuals vs predicted values.\n",
    "# A good model has residuals randomly scattered around 0 with no visible pattern.\n",
    "# Patterns (curved, funnel-shaped) suggest model misspecification or unequal variance.\n",
    "residuals = y_te.values - y_pred_slr\n",
    "axes[1].scatter(y_pred_slr, residuals, alpha=0.4, s=20, color='coral')\n",
    "axes[1].axhline(0, color='black', linewidth=1.2, linestyle='--')\n",
    "axes[1].set_xlabel('Predicted BMI')\n",
    "axes[1].set_ylabel('Residual (Actual, Predicted)')\n",
    "axes[1].set_title('Residual Plot, should look like random noise around 0')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
