   "source": [
    "# Provided: Embedded method Lasso Regression (L1 regularisation)\n",
    "#\n",
    "# Embedded methods perform feature selection DURING model training.\n",
    "# From the lecture (Week 2 Day 2):\n",
    "#   - Lasso (L1): adds a penalty = α × Σ|βⱼ| to the loss.\n",
    "#     Features with low predictive value get their coefficient shrunk to EXACTLY zero.\n",
    "#     Coefficient = 0 means the feature is effectively removed from the model.\n",
    "#   - Ridge (L2): adds a penalty = α × Σβⱼ². Shrinks coefficients toward zero\n",
    "#     but never to exactly zero, Ridge does NOT perform feature selection.\n",
    "#\n",
    "# This is why Lasso is the standard embedded feature selection tool:\n",
    "# it selects features and fits the model in one step.\n",
    "\n",
    "from sklearn.linear_model import Lasso\n",
    "from sklearn.pipeline import Pipeline\n",
    "\n",
    "# We use a Pipeline to chain scaling and Lasso prevents data leakage.\n",
    "# alpha (λ in the lecture notation) controls regularisation strength:\n",
    "#   α = 0   → plain OLS (no penalty, no selection)\n",
    "#   α large → all coefficients driven to zero (too aggressive)\n",
    "# We try three values to show the effect.\n",
    "\n",
    "print('--- Embedded Method: Lasso (L1) Feature Selection ---')\n",
    "print(f'{\"Alpha (λ)\":<12}', end='')\n",
    "for feat in FEATURE_COLS:\n",
    "    print(f'{feat[:10]:<12}', end='')\n",
    "print('Features kept')\n",
    "print('-' * (12 + 12*len(FEATURE_COLS) + 14))\n",
    "\n",
    "for alpha in [0.01, 0.1, 1.0]:\n",
    "    lasso_pipe = Pipeline([\n",
    "        ('scaler', StandardScaler()),    # fit scaler on training data (X here for selection)\n",
    "        ('lasso',  Lasso(alpha=alpha, max_iter=5000))\n",
    "    ])\n",
    "    lasso_pipe.fit(X, y)\n",
    "\n",
    "    coefs  = lasso_pipe.named_steps['lasso'].coef_\n",
    "    # A coefficient is 'zeroed out' if its absolute value is below a tiny threshold.\n",
    "    # Floating point arithmetic rarely gives exactly 0.0, so we use 1e-6 as a threshold.\n",
    "    kept   = (np.abs(coefs) > 1e-6).sum()\n",
    "    print(f'{alpha:<12}', end='')\n",
    "    for c in coefs:\n",
    "        marker = f'{c:.3f}' if abs(c) > 1e-6 else '  ZERO  '\n",
    "        print(f'{marker:<12}', end='')\n",
    "    print(f'{kept}/{len(FEATURE_COLS)}')\n",
    "\n",
    "print()\n",
    "print('Observation: as alpha increases, Lasso zeros out more coefficients.')\n",
    "print('Features zeroed at alpha=0.1 are the ones Lasso considers least useful.')\n",
    "print('Compare these eliminated features with the Pearson and RFE rankings above.')\n"
   ]
