    "# Provided: Filter method: rank features by Pearson |r| with the target\n",
    "\n",
    "# --- Filter Method: Pearson Correlation ---\n",
    "# Filter methods select features using statistical relationships computed BEFORE\n",
    "# model training: they are fast and model-agnostic.\n",
    "# Here we rank every feature by its absolute Pearson correlation with Outcome.\n",
    "# Features with |r| closer to 1 have a stronger linear relationship with the target.\n",
    "\n",
    "corr_scores = {}\n",
    "for col in FEATURE_COLS:\n",
    "    # stats.pearsonr returns (r, p_value); we only need |r| for ranking here.\n",
    "    r, p = stats.pearsonr(X[col], y)\n",
    "    corr_scores[col] = {'|r| with Outcome': round(abs(r), 4), 'p-value': round(p, 6)}\n",
    "\n",
    "corr_df = pd.DataFrame(corr_scores).T.sort_values('|r| with Outcome', ascending=False)\n",
    "\n",
    "print('--- Filter Method: Pearson |r| with Outcome ---')\n",
    "print(corr_df.to_string())\n",
    "\n",
    "# Select the top 4 features by |r|: a common heuristic for this dataset size.\n",
    "TOP_4 = corr_df.head(4).index.tolist()\n",
    "print(f'\\nTop 4 features by Pearson |r|: {TOP_4}')\n",
    "\n",
    "# Visualise as a bar chart so the ranking is immediately clear.\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "corr_df['|r| with Outcome'].plot(kind='bar', ax=ax, color='steelblue', edgecolor='white')\n",
    "ax.set_title('Feature Ranking by Pearson |r| with Outcome (Filter Method)')\n",
    "ax.set_ylabel('|Pearson r|')\n",
    "ax.tick_params(axis='x', rotation=30)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
