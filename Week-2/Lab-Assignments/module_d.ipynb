    "# Provided: Wrapper method: Recursive Feature Elimination (RFE)\n",
    "#\n",
    "# RFE is called a 'wrapper' method because it WRAPS a machine learning model\n",
    "# inside the feature selection loop. It uses the model's own sense of feature\n",
    "# importance, not a generic statistic like Pearson r.\n",
    "#\n",
    "# How RFE works (from the lecture, slide on Wrapper Methods):\n",
    "#   Step 1  Start with all features.\n",
    "#   Step 2  Train the model on the full feature set.\n",
    "#   Step 3  Rank features by importance (for LinearRegression: by |coefficient|).\n",
    "#   Step 4  Remove the LEAST important feature.\n",
    "#   Step 5  Retrain the model and repeat until n_features_to_select remain.\n",
    "\n",
    "from sklearn.feature_selection import RFE\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "# Step 1: Scale features BEFORE RFE.\n",
    "# RFE ranks by |coefficient|. If Insulin (range 0–800) is not scaled,\n",
    "# its coefficient will be tiny just because of its large scale, not\n",
    "# because it is unimportant. Scaling levels the playing field.\n",
    "scaler_rfe = StandardScaler()\n",
    "X_scaled   = scaler_rfe.fit_transform(X)   # fit on ALL data for feature selection only\n",
    "# Note: we fit on all data here because RFE is for selection, not evaluation.\n",
    "# The train/test split (for honest evaluation) comes in the next cell.\n",
    "\n",
