    "# ── Module D: Handoff Summary (self-contained) ────────────────────────────────\n",
    "# Recomputes the handful of numbers the summary needs, so nothing depends on\n",
    "# variables that later cells may have overwritten (e.g. mae/rmse/r2 get reused).\n",
    "# Requires only: df, TOP_4, RFE_TOP4  (all created by the provided Task 10 cells).\n",
    "\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.preprocessing import PolynomialFeatures\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.model_selection import train_test_split, cross_val_score, KFold\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "import numpy as np\n",
    "\n",
    "REG_FEATURES = ['Pregnancies', 'Glucose', 'BloodPressure', 'SkinThickness',\n",
    "                'Insulin', 'DiabetesPedigreeFunction', 'Age']\n",
    "\n",
    "# 5-Fold CV (BMI regression) — matches the provided CV cell\n",
    "kf = KFold(n_splits=5, shuffle=True, random_state=42)\n",
    "cv_r2 = cross_val_score(LinearRegression(), df[REG_FEATURES], df['BMI'], cv=kf, scoring='r2')\n",
    "\n",
    "# Same 80/20 split used in Tasks 11 & 12 (random_state=42)\n",
    "Xtr, Xte, ytr, yte = train_test_split(df[REG_FEATURES], df['BMI'],\n",
    "                                      test_size=0.20, random_state=42)\n",
    "\n",
    "# Simple LR: Glucose → BMI\n",
    "slr   = LinearRegression().fit(Xtr[['Glucose']], ytr)\n",
    "p_slr = slr.predict(Xte[['Glucose']])\n",
    "r2_slr, mae_lin = r2_score(yte, p_slr), mean_absolute_error(yte, p_slr)\n",
    "rmse_lin = np.sqrt(mean_squared_error(yte, p_slr))\n",
    "\n",
    "# Multiple LR: all features → BMI\n",
    "r2_mlr = r2_score(yte, LinearRegression().fit(Xtr, ytr).predict(Xte))\n",
