    "# Provided: Wrapper method: Forward Feature Selection\n",
    "#\n",
    "# Forward selection is the OPPOSITE of RFE:\n",
    "# it starts with NO features and adds the most useful one at a time.\n",
    "# From the lecture (Week 2 Day 2 slides):\n",
    "#   Step 1 Start with an empty feature set.\n",
    "#   Step 2 Test each remaining feature individually.\n",
    "#   Step 3 Add the feature that improves model score the most.\n",
    "#   Step 4 Repeat until n_features_to_select features have been added.\n",
    "#\n",
    "# sklearn provides SequentialFeatureSelector for this purpose.\n",
    "\n",
    "from sklearn.feature_selection import SequentialFeatureSelector\n",
    "\n",
    "# SequentialFeatureSelector with direction='forward' = forward selection.\n",
    "# cv=5: uses 5-fold cross-validation to score each candidate feature set.\n",
    "# scoring='r2': the feature that maximises R² is added at each step.\n",
    "sfs = SequentialFeatureSelector(\n",
    "    estimator=LinearRegression(),\n",
    "    n_features_to_select=4,\n",
    "    direction='forward',    # 'forward' adds features; 'backward' removes (= greedy RFE)\n",
    "    scoring='r2',\n",
    "    cv=5\n",
    ")\n",
    "\n",
    "# We pass X (unscaled), SequentialFeatureSelector uses CV internally,\n",
    "# so scaling would need to be inside a Pipeline for strict correctness.\n",
    "# For feature selection comparison purposes, this is sufficient.\n",
    "sfs.fit(X, y)\n",
    "\n",
    "# .get_support() returns a boolean mask aligned with FEATURE_COLS.\n",
    "sfs_mask = sfs.get_support()\n",
    "SFS_TOP4 = [feat for feat, sel in zip(FEATURE_COLS, sfs_mask) if sel]\n",
    "\n",
    "print('--- Wrapper Method: Forward Feature Selection ---')\n",
    "sfs_results = pd.DataFrame({'Feature': FEATURE_COLS, 'Selected?': sfs_mask})\n",
    "print(sfs_results.to_string(index=False))\n",
    "print(f'\\nForward selection chose: {SFS_TOP4}')\n",
    "\n",
    "# Summary across all three filter/wrapper approaches so far.\n",
    "print('\\n=== Feature Selection Summary ===')\n",
    "print(f'Pearson |r|       : {TOP_4}')\n",
    "print(f'RFE (backward)    : {RFE_TOP4}')\n",
    "print(f'Forward selection : {SFS_TOP4}')\n"
   ]
