    "# Provided: K-Fold Cross-Validation, a more robust alternative to a single train/test split\n",
    "#\n",
    "# From the lecture (Week 2 Day 2, 'Methods for Model Evaluation'):\n",
    "#   Train-Test Split → one split, fast, but the result depends on which rows\n",
    "#                       happened to land in the test set (luck of the draw).\n",
    "#   K-Fold CV        → the data is split into k folds; the model is trained and\n",
    "#                       tested k times, each fold gets a turn as the test set.\n",
    "#                       Results are averaged → a more stable, less luck-dependent estimate.\n",
    "#                       Common choices: k = 5 or k = 10 (we use k = 5 here).\n",
    "#\n",
    "# We evaluate the SAME Linear Regression / REG_FEATURES setup used in Task 11,\n",
    "# so the comparison between a single split and K-Fold CV is apples-to-apples.\n",
    "\n",
    "from sklearn.model_selection import cross_val_score, KFold\n",
    "from sklearn.linear_model import LinearRegression\n",
    "\n",
    "REG_FEATURES_CV = ['Pregnancies', 'Glucose', 'BloodPressure', 'SkinThickness',\n",
    "                    'Insulin', 'DiabetesPedigreeFunction', 'Age']\n",
    "X_cv = df[REG_FEATURES_CV]\n",
    "y_cv = df['BMI']\n",
    "\n",
    "kf = KFold(n_splits=5, shuffle=True, random_state=42)  # same RANDOM_STATE=42 as everywhere else\n",
    "\n",
    "cv_r2_scores = cross_val_score(LinearRegression(), X_cv, y_cv, cv=kf, scoring='r2')\n",
    "\n",
    "print('--- 5-Fold Cross-Validation: Linear Regression predicting BMI ---')\n",
    "print(f'R² per fold : {np.round(cv_r2_scores, 3)}')\n",
    "print(f'Mean R²     : {cv_r2_scores.mean():.3f}')\n",
    "print(f'Std  R²     : {cv_r2_scores.std():.3f}  (spread across folds = how lucky/unlucky a single split could be)')\n",
    "print()\n",
    "print('Compare this Mean R² (and its spread) to the single train/test split R² you will compute in Task 11.')\n",
    "print('A single split gives ONE number; K-Fold CV gives a DISTRIBUTION, which is the more honest picture.')\n"
   ]
