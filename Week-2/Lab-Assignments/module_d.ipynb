    "# Provided: compute all four evaluation metrics and explain each one\n",
    "\n",
    "# Fit a simple linear model (degree=1) our baseline for the comparison.\n",
    "lin_model = LinearRegression()\n",
    "lin_model.fit(X_tr_1d, y_tr_1d)\n",
    "y_pred_lin = lin_model.predict(X_te_1d)\n",
    "\n",
    "# --- Metric 1: MAE (Mean Absolute Error) ---\n",
    "# Average of |actual - predicted| across all test rows.\n",
    "# Interpretation: on average, our prediction is off by MAE BMI units.\n",
    "# Advantage: same units as the target; easy to explain to non-technical audiences.\n",
    "mae  = mean_absolute_error(y_te_1d, y_pred_lin)\n",
    "\n",
    "# --- Metric 2: MSE (Mean Squared Error) ---\n",
    "# Average of (actual - predicted)² across all test rows.\n",
    "# Penalises large errors MORE than small ones (squaring amplifies them).\n",
    "# Disadvantage: units are squared (e.g. BMI²) not directly interpretable.\n",
    "mse  = mean_squared_error(y_te_1d, y_pred_lin)\n",
    "\n",
    "# --- Metric 3: RMSE (Root Mean Squared Error) ---\n",
    "# Square root of MSE restores the original units (BMI).\n",
    "# More sensitive to large errors than MAE; the most commonly reported metric.\n",
    "rmse = np.sqrt(mse)\n",
    "\n",
    "# --- Metric 4: R² (Coefficient of Determination) ---\n",
    "# R² = 1 - (SS_residual / SS_total)\n",
    "# Interpretation: 'the model explains R²% of the variance in BMI.'\n",
    "# R² = 1: perfect predictions. R² = 0: model is no better than predicting the mean.\n",
    "# R² can be negative if the model is worse than predicting the mean.\n",
    "r2   = r2_score(y_te_1d, y_pred_lin)\n",
    "\n",
    "print('--- Linear Regression Evaluation Metrics (Test Set) ---')\n",
    "print(f'MAE  = {mae:.4f}  → average absolute prediction error in BMI units')\n",
    "print(f'MSE  = {mse:.4f}  → average squared error (BMI²) penalises large errors heavily')\n",
    "print(f'RMSE = {rmse:.4f}  → back in BMI units; typical prediction error ≈ {rmse:.1f} BMI points')\n",
    "print(f'R²   = {r2:.4f}  → the model explains {r2*100:.1f}% of BMI variance')\n"
