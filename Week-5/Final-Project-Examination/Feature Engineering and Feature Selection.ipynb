    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "def prepare_features(df, target_column):\n",
    "    \"\"\"\n",
    "    Prepare dataset for feature selection and machine learning.\n",
    "    \"\"\"\n",
    "\n",
    "    # Separate features and target\n",
    "    X = df.drop(columns=[target_column]).copy()\n",
    "    y = df[target_column].copy()\n",
    "\n",
    "    # Remove string/object columns\n",
    "    X = X.select_dtypes(exclude=[\"object\", \"string\"])\n",
    "\n",
    "    # Convert boolean columns to integers\n",
    "    bool_cols = X.select_dtypes(include=\"bool\").columns\n",
    "    X[bool_cols] = X[bool_cols].astype(int)\n",
    "\n",
    "    # Remove rows with missing values (if any)\n",
    "    X = X.fillna(0)\n",
    "\n",
    "    return X, y\n",
    "\n",
    "\n",
    "# Regression dataset\n",
    "X_reg, y_reg = prepare_features(\n",
    "    regression_df,\n",
    "    \"prize_money_usd_m\"\n",
    ")\n",
    "\n",
    "# Classification dataset\n",
    "X_cls, y_cls = prepare_features(\n",
    "    classification_df,\n",
    "    \"is_constructors_champion\"\n",
    ")\n",
    "\n",
    "print(\"Regression shape:\", X_reg.shape)\n",
    "print(\"Classification shape:\", X_cls.shape)\n",
    "\n",
    "print(\"\\nRemaining non-numeric columns (Regression):\")\n",
    "print(X_reg.select_dtypes(exclude=[\"number\"]).columns.tolist())\n",
    "\n",
    "print(\"\\nRemaining non-numeric columns (Classification):\")\n",
    "print(X_cls.select_dtypes(exclude=[\"number\"]).columns.tolist())"
   ]
