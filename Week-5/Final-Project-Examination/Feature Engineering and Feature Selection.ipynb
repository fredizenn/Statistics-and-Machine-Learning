    "#make a copy of constructor_finances_data\n",
    "cf = constructor_finances_data.copy()\n",
    "\n",
    "#In this step, we replace the missing values in the cost_cap_limit_usd_m column with 0.\n",
    "cf[\"cost_cap_limit_usd_m\"] = cf[\"cost_cap_limit_usd_m\"].fillna(0)\n",
    "\n",
    "\n",
    "#In this step, we do an outlier check on the money columns, using IQR flags.\n",
    "#Anything below Q1 - 1.5xIQR or above Q3 + 1.5xIQR is flagged. On the four money(continuous) columns.\n",
    "money_cols = [\"operating_budget_usd_m\", \"sponsorship_revenue_usd_m\",\n",
    "              \"prize_money_usd_m\", \"total_revenue_usd_m\"]\n",
    "\n",
    "for col in money_cols:\n",
    "    q1, q3 = cf[col].quantile([0.25, 0.75])\n",
    "    iqr = q3 - q1\n",
    "    lo, hi = q1 - 1.5 * iqr, q3 + 1.5 * iqr\n",
    "    flagged = cf[(cf[col] < lo) | (cf[col] > hi)]\n",
    "    print(f\"{col}: {len(flagged)} outlier rows (bounds {lo:.1f}–{hi:.1f})\")\n",
    "    if len(flagged):\n",
    "        print(flagged[[\"season\", \"team_name\", col]])"
   ]
