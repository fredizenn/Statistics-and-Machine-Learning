    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e7509703",
   "metadata": {},
   "source": [
    "### Feature 3\n",
    "\n",
    "Sponsorship Percentage\n",
    "\n",
    "Formula\n",
